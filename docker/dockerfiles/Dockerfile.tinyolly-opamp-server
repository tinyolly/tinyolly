# Build stage (keep versions in sync with /versions.env)
ARG GO_VERSION=1.27
FROM golang:${GO_VERSION}-alpine AS builder

WORKDIR /app

# Install git for fetching dependencies
RUN apk add --no-cache git

# Copy go mod files (go.sum is committed; do NOT run `go mod tidy` here)
COPY apps/tinyolly-opamp-server/go.mod apps/tinyolly-opamp-server/go.sum ./

# Copy source code
COPY apps/tinyolly-opamp-server/*.go ./

# Download dependencies (verified against go.sum)
RUN go mod download

# Build the binary
RUN CGO_ENABLED=0 GOOS=linux go build -o /tinyolly-opamp-server .

# Runtime stage
FROM alpine:3.22

# Install bash for better shell experience (bash-completion not readily available in Alpine)
RUN apk add --no-cache \
    ca-certificates \
    bash \
    coreutils

# Set bash as default shell
SHELL ["/bin/bash", "-c"]

COPY --from=builder /tinyolly-opamp-server /tinyolly-opamp-server

# OpAMP port for collector connections
EXPOSE 4320
# HTTP REST API port
EXPOSE 4321

CMD ["/tinyolly-opamp-server"]
